      "ClientId": "669454291425-1cprkafiodv2kib89neegti0rgmbp34v.apps.googleusercontent.com",
      "ClientSecret": "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"
    }
  }
}
